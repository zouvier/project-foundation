{
  "receipt_version": 1,
  "foundation_version": "0.1.3",
  "source_path": {{ _copier_answers.get('_src_path') | to_json }},
  "source_ref": {{ _copier_answers.get('_commit') | to_json }},
  "source_commit": {{ _copier_conf.vcs_ref_hash | to_json }},
  "project_name": {{ project_name | to_json }},
  "package_name": {{ package_name | to_json }},
  "profile": {{ profile | to_json }},
{% if profile == 'typescript-web' %}
  "runtime": {"runner_python_min": "3.9", "node": "24.11.1", "npm": "11.6.2"}
{% else %}
  "runtime": {"runner_python_min": "3.9", "python": "3.13.5", "uv": "0.11.8"}
{% endif %}
}
