{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Single task and handoff record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "state", "goal", "allowed_paths", "acceptance_checks", "base_commit", "results", "unrun_checks", "blockers", "next_action"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "state": {"enum": ["planned", "in_progress", "blocked", "completed"]},
    "goal": {"type": "string", "minLength": 1},
    "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "acceptance_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "base_commit": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-f0-9]{40}$"}]},
    "results": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["command", "exit_code", "evidence"],
      "properties": {"command": {"type": "string", "minLength": 1}, "exit_code": {"type": "integer"}, "evidence": {"type": "string", "minLength": 1}}
    }},
    "unrun_checks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "next_action": {"type": "string", "minLength": 1}
  }
}
